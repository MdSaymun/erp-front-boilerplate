{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "ask": ["Bash(git push*)", "Bash(git commit*)", "Bash(npm install *)", "Bash(npm uninstall *)"],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Read(.env.production)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Edit(public/mockServiceWorker.js)",
      "Edit(package-lock.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; [ -n \"$f\" ] && cd \"$CLAUDE_PROJECT_DIR\" && npx --no-install prettier --write --log-level warn --ignore-unknown \"$f\"; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting with Prettier"
          }
        ]
      }
    ]
  }
}
