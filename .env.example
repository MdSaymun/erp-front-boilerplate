# Copy to .env.development / .env.production and adjust.
# All VITE_* variables are embedded in the client bundle and are PUBLIC.
# Never put secrets, API keys, or connection strings here.

VITE_APP_NAME=ERP
VITE_API_BASE_URL=http://localhost:5000/api
VITE_ENVIRONMENT=development

# Serve API responses from Mock Service Worker (development only).
VITE_MOCK_API=true
# SignalR hub URL; leave empty to disable real-time features.
VITE_REALTIME_URL=
